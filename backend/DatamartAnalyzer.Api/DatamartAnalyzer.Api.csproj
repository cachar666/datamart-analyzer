<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DatamartAnalyzer.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>


  <ItemGroup>
    <!-- Los scripts de migracion se ENLAZAN desde el proyecto de migraciones, no se
         copian: una sola fuente de verdad. El LogicalName replica el nombre de recurso
         que usa DbUp, que es la identidad del script en la tabla SchemaVersions; asi la
         API y almacen.ps1 leen y escriben el mismo journal y ninguno repite trabajo. -->
    <EmbeddedResource Include="..\DatamartAnalyzer.Migrations\Scripts\*.sql">
      <LogicalName>DatamartAnalyzer.Migrations.Scripts.%(Filename)%(Extension)</LogicalName>
      <Link>Scripts\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
