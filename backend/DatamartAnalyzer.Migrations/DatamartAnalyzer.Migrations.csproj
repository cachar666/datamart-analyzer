<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DatamartAnalyzer.Migrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aislado a proposito: dbup-sqlserver 7.2.0 exige Microsoft.Data.SqlClient >= 6.1.4,
         y la API sigue en 5.2.2. Al vivir en otro proyecto, ese salto no la afecta. -->
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Todo .sql bajo Scripts/ viaja embebido en el assembly y lo descubre DbUp. -->
    <EmbeddedResource Include="Scripts\**\*.sql" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
