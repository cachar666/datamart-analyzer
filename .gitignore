[Bb]in/
[Oo]bj/

backend/DatamartAnalyzer.Api/appsettings.Development.json
backend/DatamartAnalyzer.Api/appsettings.Production.json
*.user
*.suo
.vs/

# ─── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

