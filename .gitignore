# ─── Backend ──────────────────────────────────────────────────────────────────
# Genericos: cubren cualquier proyecto .NET nuevo sin tener que acordarse de
# agregarlo. Antes estaban por ruta y DatamartAnalyzer.Migrations quedo afuera.
[Bb]in/
[Oo]bj/

backend/DatamartAnalyzer.Api/appsettings.Development.json
backend/DatamartAnalyzer.Api/appsettings.Production.json
*.user
*.suo
.vs/

# ─── Conector MCP (paquete .mcpb) ─────────────────────────────────────────────
# Se versiona manifest.json y el icono; lo demas es salida del build.
# connector/server/ son ~84 MB de publish self-contained y dist/ el .mcpb armado.
connector/build/
connector/server/
connector/icon.png
dist/

# ─── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# ─── Docs binarios y extractor compilado ──────────────────────────────────────
docs/*.docx
docs/extracted_raw.txt

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
**/.idea/

# ─── Sistema ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

frontend/dist-check*/
frontend/vite.config.js.timestamp-*.mjs
